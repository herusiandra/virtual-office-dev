# Telegram Bot Token (dari @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Telegram User ID yang diizinkan (angka, dari @userinfobot)
TELEGRAM_ALLOWED_USER=123456789

# Path binary herdr & konfigurasi heru
HERDR_BIN=/usr/local/bin/herdr
HERU_PANE=office:agent-main.0
HERU_DIR=/home/safewatch/agent/office/agent-main
OFFICE_DIR=/home/safewatch/agent/office
DB_PATH=/home/safewatch/agent/office/telegram-bridge/bridge.db
BRAIN_DIR=/home/safewatch/.gemini/antigravity-cli/brain
